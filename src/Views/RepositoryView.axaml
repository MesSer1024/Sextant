<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sextant.ViewModels"
             xmlns:views="using:Sextant.Views"
             xmlns:controls="using:Sextant.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="640"
             x:Class="Sextant.Views.RepositoryView"
             x:DataType="vm:RepositoryViewModel">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
        <Border Grid.Row="0" IsVisible="{Binding HasBanner}" Padding="10,6" Background="#33C42B1C">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                    <Button Classes="flat" Content="Copy" Command="{Binding CopyBannerCommand}"/>
                    <Button Classes="flat" Content="Dismiss" Command="{Binding DismissBannerCommand}"/>
                </StackPanel>
                <TextBlock Text="{Binding Banner}" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" IsVisible="{Binding IsConflicted}" Padding="10,6" Background="#33E0A100">
            <TextBlock Text="{Binding ConflictText}" TextWrapping="Wrap"/>
        </Border>

        <Border Grid.Row="2" IsVisible="{Binding SparseCheckout}" Padding="10,6" Background="#332B6CB0">
            <TextBlock Text="Sparse checkout is on. Excluded paths stay out of the working tree." TextWrapping="Wrap"/>
        </Border>

        <Grid Grid.Row="3" Margin="8,6" Grid.IsSharedSizeScope="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="BranchEnds"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto" SharedSizeGroup="BranchEnds"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MinWidth="168"
                    MaxWidth="420"
                    Padding="16,5"
                    CornerRadius="14"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                    Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding BranchText}" FontWeight="SemiBold" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                    <TextBlock Text="·" Opacity="0.45" VerticalAlignment="Center" IsVisible="{Binding ShowBranchStatus}"/>
                    <TextBlock Text="{Binding AheadBehindText}" IsVisible="{Binding ShowAheadBehind}"
                               VerticalAlignment="Center" Opacity="0.72" FontSize="12"/>
                    <TextBlock Text="{Binding BusyText}" IsVisible="{Binding IsBusy}"
                               VerticalAlignment="Center" Opacity="0.72" FontSize="12"
                               TextTrimming="CharacterEllipsis" MaxWidth="160"/>
                </StackPanel>
            </Border>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Panel.ZIndex="1">
                <SplitButton Content="Pull" Command="{Binding PullCommand}" IsEnabled="{Binding CanRunCommands}">
                    <SplitButton.Flyout>
                        <MenuFlyout>
                            <MenuItem Header="Fetch" Command="{Binding FetchCommand}"/>
                        </MenuFlyout>
                    </SplitButton.Flyout>
                </SplitButton>
                <SplitButton Content="Push" Command="{Binding PushCommand}" Margin="6,0,0,0" IsEnabled="{Binding CanRunCommands}">
                    <SplitButton.Flyout>
                        <MenuFlyout>
                            <MenuItem Header="Push" Command="{Binding PushCommand}"/>
                            <MenuItem Header="Push ignoring local checks" Command="{Binding PushIgnoringLocalChecksCommand}"/>
                            <MenuItem Header="Push with force-with-lease" Command="{Binding PushForceWithLeaseCommand}"/>
                        </MenuFlyout>
                    </SplitButton.Flyout>
                </SplitButton>
                <Button Content="Continue" Command="{Binding ContinueSequencerCommand}" Margin="6,0,0,0" IsVisible="{Binding IsConflicted}"/>
                <Button Content="Abort" Command="{Binding AbortMergeCommand}" Margin="6,0,0,0" IsVisible="{Binding IsConflicted}"/>
                <Button Content="Cancel" Command="{Binding CancelCommand}" Margin="6,0,0,0" IsVisible="{Binding CanCancel}"/>
            </StackPanel>
        </Grid>

        <Grid x:Name="Columns" Grid.Row="4" Margin="4,0,4,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="140"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="460" MinWidth="360"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*" MinWidth="320"/>
            </Grid.ColumnDefinitions>

            <ListBox Grid.Column="0" ItemsSource="{Binding Locations}" SelectedItem="{Binding SelectedLocation}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     DoubleTapped="OnLocationDoubleTapped">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="2,0"/>
                        <Setter Property="MinHeight" Value="0"/>
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:LocationItem">
                        <Grid ColumnDefinitions="16,*" Margin="{Binding Indent}">
                            <Button Grid.Column="0" Classes="flat" Width="16" Height="16" Padding="0" MinWidth="0"
                                    IsVisible="{Binding HasChildren}"
                                    Click="OnLocationExpand" DoubleTapped="OnLocationExpandDoubleTapped"
                                    Background="Transparent" VerticalAlignment="Center">
                                <Path Data="M2,1 L7,6 L2,11" Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}" StrokeThickness="1.4"
                                      StrokeLineCap="Round" StrokeJoin="Round" Stretch="None"
                                      RenderTransformOrigin="50%,50%">
                                    <Path.RenderTransform>
                                        <RotateTransform Angle="{Binding ExpandAngle}"/>
                                    </Path.RenderTransform>
                                </Path>
                            </Button>
                            <Border Grid.Column="1">
                                <Border.ContextMenu>
                                    <ContextMenu Opening="OnMenuOpening">
                                        <MenuItem Header="Open" Command="{Binding OpenCommand}" IsVisible="{Binding ShowOpen}"/>
                                        <MenuItem Header="Checkout" Command="{Binding CheckoutCommand}" IsVisible="{Binding ShowCheckout}"/>
                                        <MenuItem Header="{Binding MergeLabel}" Command="{Binding MergeCommand}" IsVisible="{Binding ShowMerge}"/>
                                        <MenuItem Header="{Binding RebaseLabel}" Command="{Binding RebaseCommand}" IsVisible="{Binding ShowRebase}"/>
                                        <MenuItem Header="Delete" Command="{Binding DeleteCommand}" IsVisible="{Binding ShowDelete}"/>
                                        <MenuItem Header="Set upstream" Command="{Binding SetUpstreamCommand}" IsVisible="{Binding ShowSetUpstream}"/>
                                        <MenuItem Header="Show in graph" Command="{Binding RevealCommand}" IsVisible="{Binding ShowReveal}"/>
                                        <MenuItem Header="Rename" Command="{Binding RenameCommand}" IsVisible="{Binding ShowRename}"/>
                                        <MenuItem Header="Pop" Command="{Binding PopCommand}" IsVisible="{Binding ShowPop}"/>
                                        <MenuItem Header="Apply" Command="{Binding ApplyCommand}" IsVisible="{Binding ShowApply}"/>
                                        <MenuItem Header="Drop" Command="{Binding DropCommand}" IsVisible="{Binding ShowDrop}"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <TextBlock Text="{Binding Label}" FontWeight="{Binding Weight}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <GridSplitter Grid.Column="1" ResizeDirection="Columns"/>

            <Grid x:Name="HistoryColumn" Grid.Column="2" RowDefinitions="320,4,*">
            <DockPanel Grid.Row="2" MinHeight="120">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,4" Spacing="4" IsVisible="{Binding ShowHistoryChrome}">
                    <Grid ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding ShowHistorySearch}">
                        <TextBox x:Name="HistorySearchBox" PlaceholderText="Search subject, author, sha, or branch:name" Text="{Binding HistoryText}" KeyDown="OnHistoryKeyDown"/>
                        <Button Grid.Column="1" Classes="flat" Content="Search" Command="{Binding SearchHistoryCommand}" Margin="4,0,0,0"/>
                        <Button Grid.Column="2" Classes="flat" Content="Clear" Command="{Binding ClearHistoryCommand}" Margin="4,0,0,0"/>
                    </Grid>
                    <TextBlock Text="{Binding HistoryCaption}" IsVisible="{Binding HasHistoryFilter}" Opacity="0.75" TextWrapping="Wrap"/>
                </StackPanel>
                <Button Classes="flat" DockPanel.Dock="Bottom" Content="{Binding LoadMoreText}" Command="{Binding LoadMoreCommand}"
                        IsVisible="{Binding ShowLoadMore}" HorizontalAlignment="Stretch" Margin="0,4,0,0"/>
                <ListBox x:Name="GraphList" Classes="graph" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedGraphRow}"
                         SelectionMode="Multiple" SelectionChanged="OnGraphSelectionChanged">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="4,0"/>
                            <Setter Property="MinHeight" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:GraphRowViewModel">
                            <Grid ColumnDefinitions="Auto,*">
                                <Grid.ContextMenu>
                                    <ContextMenu Opening="OnMenuOpening">
                                        <MenuItem Header="Checkout" Command="{Binding CheckoutCommand}" IsVisible="{Binding ShowCheckout}"/>
                                        <MenuItem Header="Create branch at HEAD" Command="{Binding CreateBranchCommand}"/>
                                        <MenuItem Header="Copy SHA" Command="{Binding CopyShaCommand}" IsVisible="{Binding ShowLanes}"/>
                                        <MenuItem Header="Reset soft" Command="{Binding ResetSoftCommand}" IsVisible="{Binding ShowRewrite}"/>
                                        <MenuItem Header="Reset mixed" Command="{Binding ResetMixedCommand}" IsVisible="{Binding ShowRewrite}"/>
                                        <MenuItem Header="Reset hard" Command="{Binding ResetHardCommand}" IsVisible="{Binding ShowRewrite}"/>
                                        <MenuItem Header="Cherry-pick" Command="{Binding CherryPickCommand}" IsVisible="{Binding ShowRewrite}"/>
                                        <MenuItem Header="Revert" Command="{Binding RevertCommand}" IsVisible="{Binding ShowRewrite}"/>
                                        <MenuItem Header="Rebase interactive…" Command="{Binding RebaseCommand}" IsVisible="{Binding ShowRewrite}"/>
                                        <MenuItem Header="Reword…" Command="{Binding RewordCommand}" IsVisible="{Binding ShowRewrite}"/>
                                        <MenuItem Header="Tag" Command="{Binding TagCommand}" IsVisible="{Binding ShowRewrite}"/>
                                    </ContextMenu>
                                </Grid.ContextMenu>
                                <controls:LaneCanvas Grid.Column="0" Geometry="{Binding Lanes}" IsVisible="{Binding ShowLanes}" VerticalAlignment="Stretch" Margin="0,0,8,0"/>
                                <StackPanel Grid.Column="1" Margin="0,3" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Subject}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                    <TextBlock Text="{Binding Detail}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" FontSize="12" Opacity="0.65" Margin="0,1,0,0"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

                <GridSplitter Grid.Row="1" ResizeDirection="Rows"/>

                <Grid Grid.Row="0" RowDefinitions="Auto,Auto,*" MinHeight="140">

                <StackPanel Grid.Row="0">
                    <Border IsVisible="{Binding ShowingWorkingCopy}" Padding="8,6,8,4">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,6,0,0">
                                <TextBlock Text="Nothing staged." IsVisible="{Binding NothingStaged}" VerticalAlignment="Center" Opacity="0.7"/>
                                <SplitButton Content="Commit" Command="{Binding CommitCommand}" IsEnabled="{Binding CanCommitOrAmend}">
                                    <SplitButton.Flyout>
                                        <MenuFlyout>
                                            <MenuItem Header="Commit without hooks" Command="{Binding CommitWithoutHooksCommand}" IsEnabled="{Binding CanCommit}"/>
                                            <MenuItem Header="Amend" Command="{Binding AmendCommand}" IsEnabled="{Binding CanAmend}"/>
                                        </MenuFlyout>
                                    </SplitButton.Flyout>
                                </SplitButton>
                            </StackPanel>
                            <TextBox Text="{Binding CommitMessage}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64"
                                     PlaceholderText="Commit message" KeyDown="OnCommitKeyDown"/>
                        </DockPanel>
                    </Border>
                    <StackPanel IsVisible="{Binding ShowingCommit}" Margin="8,6,8,4" Spacing="2">
                        <TextBlock Text="{Binding CommitTitle}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding CommitMeta}" Opacity="0.7" FontSize="12"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="8,0,8,4" IsVisible="{Binding ShowingWorkingCopy}">
                    <Button Content="Stage all" Command="{Binding StageAllCommand}" IsEnabled="{Binding CanStageAll}"/>
                    <Button Content="Unstage all" Command="{Binding UnstageAllCommand}" IsEnabled="{Binding CanUnstageAll}"/>
                </StackPanel>

                <ListBox x:Name="FileList" Grid.Row="2" ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}"
                         PointerReleased="OnFilePointerReleased">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:FileRowViewModel">
                            <Grid ColumnDefinitions="22,*,Auto">
                                <Grid.ContextMenu>
                                    <ContextMenu Opening="OnMenuOpening">
                                        <MenuItem Header="Stage" Command="{Binding StageCommand}" IsVisible="{Binding ShowStage}"/>
                                        <MenuItem Header="Unstage" Command="{Binding UnstageCommand}" IsVisible="{Binding ShowUnstage}"/>
                                        <MenuItem Header="Discard" Command="{Binding DiscardCommand}" IsVisible="{Binding ShowDiscard}"/>
                                        <MenuItem Header="Open in merge tool" Command="{Binding MergetoolCommand}" IsVisible="{Binding ShowMergetool}"/>
                                        <MenuItem Header="File history" Command="{Binding HistoryCommand}" IsVisible="{Binding ShowHistory}"/>
                                    </ContextMenu>
                                </Grid.ContextMenu>
                                <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" VerticalAlignment="Center" IsVisible="{Binding IsFile}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Label}" FontWeight="SemiBold" Opacity="0.7" IsVisible="{Binding IsHeader}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" IsVisible="{Binding IsFile}" ToolTip.Tip="{Binding Path}"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsFile}">
                                    <Button Classes="flat" Content="Stage" Command="{Binding StageCommand}" IsVisible="{Binding ShowStage}" Padding="6,0"/>
                                    <Button Classes="flat" Content="Unstage" Command="{Binding UnstageCommand}" IsVisible="{Binding ShowUnstage}" Padding="6,0"/>
                                    <Button Classes="flat" Content="Discard" Command="{Binding DiscardCommand}" IsVisible="{Binding ShowDiscard}" Padding="6,0"/>
                                    <Button Classes="flat" Content="Merge tool" Command="{Binding MergetoolCommand}" IsVisible="{Binding ShowMergetool}" Padding="6,0"/>
                                    <Button Classes="flat" Content="History" Command="{Binding HistoryCommand}" IsVisible="{Binding ShowHistory}" Padding="6,0"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                </Grid>
            </Grid>

            <GridSplitter Grid.Column="3" ResizeDirection="Columns"/>

            <Grid x:Name="Details" Grid.Column="4">
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Top" Margin="8,4,8,0">
                        <Button Classes="flat" Content="{Binding SideBySideLabel}" Command="{Binding ToggleSideBySideCommand}" Margin="0,0,4,4"/>
                        <Button Classes="flat" Content="{Binding WhitespaceLabel}" Command="{Binding ToggleWhitespaceCommand}" Margin="0,0,4,4"/>
                        <Button Classes="flat" Content="{Binding FilesModeLabel}" Command="{Binding ToggleAllFilesCommand}" Margin="0,0,4,4"/>
                        <Button Classes="flat" Content="{Binding BlameLabel}" Command="{Binding ToggleBlameCommand}" Margin="0,0,4,4"/>
                        <Button Classes="flat" Content="{Binding MergeBaseLabel}" Command="{Binding ToggleMergeBaseCommand}" IsVisible="{Binding ShowingMerge}" Margin="0,0,4,4"/>
                        <Button Classes="flat" Content="Save and stage" Command="{Binding SaveConflictCommand}" IsVisible="{Binding ShowingMerge}" Margin="0,0,4,4"/>
                    </WrapPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="8,4">
                        <TextBlock Text="{Binding DiffNotice}" IsVisible="{Binding HasDiffNotice}" TextWrapping="Wrap" Opacity="0.75"/>
                        <Button Classes="flat" Content="Load anyway" Command="{Binding LoadLargeDiffCommand}" IsVisible="{Binding ShowLoadDiff}" HorizontalAlignment="Left" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding LfsNotice}" IsVisible="{Binding HasLfsNotice}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        <Button Classes="flat" Content="Show the file" Command="{Binding ShowLfsCommand}" IsVisible="{Binding ShowLfsDownload}" HorizontalAlignment="Left" Margin="0,4,0,0"/>
                    </StackPanel>
                    <ScrollViewer x:Name="ImageStrip" DockPanel.Dock="Top" IsVisible="{Binding ShowingImages}" MaxHeight="640"
                                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ImageRows" ItemsSource="{Binding ImageCompares}" Margin="8,0,8,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ImageCompareRow">
                                    <StackPanel Margin="0,0,0,12">
                                        <Border Margin="0,0,0,6" Padding="10,6" CornerRadius="6" BorderThickness="1"
                                                HorizontalAlignment="Stretch"
                                                Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                                                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
                                            <TextBlock Text="{Binding Path}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        </Border>
                                        <Grid ColumnDefinitions="*,12,*">
                                            <Border Padding="8" MinHeight="280" Background="#1A000000" BorderThickness="1"
                                                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Top" Text="{Binding BeforeCaption}" Opacity="0.72" Margin="0,0,0,8"/>
                                                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding BeforeDetail}" IsVisible="{Binding HasBeforeDetail}" TextWrapping="Wrap" Opacity="0.75" Margin="0,8,0,0"/>
                                                    <TextBlock Text="{Binding BeforeNotice}" IsVisible="{Binding ShowBeforeNotice}" TextWrapping="Wrap" VerticalAlignment="Center" Opacity="0.75"/>
                                                    <controls:FbxOrbitView Source="{Binding Before}" Orbit="{Binding BeforeOrbit}" IsHitTestVisible="{Binding HasBeforeOrbit}"
                                                                           MaxHeight="420" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding HasBefore}"/>
                                                </DockPanel>
                                            </Border>
                                            <Border Grid.Column="2" Padding="8" MinHeight="280" Background="#1A000000" BorderThickness="1"
                                                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Top" Text="{Binding AfterCaption}" Opacity="0.72" Margin="0,0,0,8"/>
                                                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding AfterDetail}" IsVisible="{Binding HasAfterDetail}" TextWrapping="Wrap" Opacity="0.75" Margin="0,8,0,0"/>
                                                    <TextBlock Text="{Binding AfterNotice}" IsVisible="{Binding ShowAfterNotice}" TextWrapping="Wrap" VerticalAlignment="Center" Opacity="0.75"/>
                                                    <controls:FbxOrbitView Source="{Binding After}" Orbit="{Binding AfterOrbit}" IsHitTestVisible="{Binding HasAfterOrbit}"
                                                                           MaxHeight="420" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding HasAfter}"/>
                                                </DockPanel>
                                            </Border>
                                            <StackPanel Grid.ColumnSpan="3" IsVisible="{Binding IsLoading}" IsHitTestVisible="False"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                                                <controls:LoadingSpinner Width="22" Height="22" HorizontalAlignment="Center"
                                                                         IsVisible="{Binding IsLoading}"
                                                                         AutomationProperties.Name="Loading image"/>
                                                <TextBlock Text="Loading…" HorizontalAlignment="Center" Opacity="0.72"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Grid DockPanel.Dock="Top" IsVisible="{Binding ShowingMerge}" ColumnDefinitions="*,8,*,8,*" Margin="8,4,8,0">
                        <TextBlock Text="Ours" FontWeight="SemiBold" Opacity="0.75"/>
                        <TextBlock Grid.Column="2" Text="Result" FontWeight="SemiBold" Opacity="0.75"/>
                        <TextBlock Grid.Column="4" Text="Theirs" FontWeight="SemiBold" Opacity="0.75"/>
                    </Grid>
                    <Grid>
                        <views:CopyListBox x:Name="DiffList" ItemsSource="{Binding DiffRows}" Background="Transparent" IsVisible="{Binding ShowingDiff}">
                            <views:CopyListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </views:CopyListBox.Styles>
                            <views:CopyListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel/>
                                </ItemsPanelTemplate>
                            </views:CopyListBox.ItemsPanel>
                            <views:CopyListBox.DataTemplates>
                                <DataTemplate DataType="vm:DiffHunkRow" x:DataType="vm:DiffHunkRow">
                                    <DockPanel Margin="8,6,8,2">
                                        <Button Classes="flat" DockPanel.Dock="Right" Content="{Binding ActionLabel}" Command="{Binding ActionCommand}" IsVisible="{Binding ShowAction}" Padding="6,0"/>
                                        <views:CopyableText Classes="diff" CopyKey="span" Text="{Binding Header}" Opacity="0.7"/>
                                    </DockPanel>
                                </DataTemplate>
                                <DataTemplate DataType="vm:DiffLineRow" x:DataType="vm:DiffLineRow">
                                    <DockPanel>
                                        <Button Classes="flat" DockPanel.Dock="Right" Content="{Binding ActionLabel}" Command="{Binding ActionCommand}" IsVisible="{Binding ShowAction}" Padding="6,0"/>
                                        <views:HighlightedText Classes="diff" CopyKey="body" Source="{Binding Text}" Language="{Binding Language}" Background="{Binding Background}" Padding="8,0"/>
                                    </DockPanel>
                                </DataTemplate>
                                <DataTemplate DataType="vm:DiffSideRow" x:DataType="vm:DiffSideRow">
                                    <Grid ColumnDefinitions="*,*">
                                        <views:HighlightedText Classes="diff" CopyKey="left" Source="{Binding Left}" Language="{Binding Language}" Background="{Binding LeftBackground}" Padding="8,0"/>
                                        <views:HighlightedText Grid.Column="1" Classes="diff" CopyKey="right" Source="{Binding Right}" Language="{Binding Language}" Background="{Binding RightBackground}" Padding="8,0"/>
                                    </Grid>
                                </DataTemplate>
                                <DataTemplate DataType="vm:DiffFileRow" x:DataType="vm:DiffFileRow">
                                    <Border Margin="8,10,8,4" Padding="10,6" CornerRadius="6" BorderThickness="1"
                                            HorizontalAlignment="Stretch"
                                            Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                                            BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
                                        <views:CopyableText CopyKey="span" Text="{Binding Label}" FontWeight="SemiBold"
                                                            HorizontalAlignment="Stretch" TextTrimming="CharacterEllipsis"/>
                                    </Border>
                                </DataTemplate>
                            </views:CopyListBox.DataTemplates>
                        </views:CopyListBox>
                        <views:CopyListBox ItemsSource="{Binding BlameRows}" Background="Transparent" IsVisible="{Binding ShowingBlame}">
                            <views:CopyListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel/>
                                </ItemsPanelTemplate>
                            </views:CopyListBox.ItemsPanel>
                            <views:CopyListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:BlameRow">
                                    <Grid ColumnDefinitions="48,180,*">
                                        <views:CopyableText Classes="diff" CopyKey="number" Text="{Binding Number}" Opacity="0.55"/>
                                        <views:CopyableText Grid.Column="1" Classes="diff" CopyKey="meta" Text="{Binding Meta}" Opacity="0.75" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                        <views:CopyableText Grid.Column="2" Classes="diff" CopyKey="blame" Text="{Binding Text}"/>
                                    </Grid>
                                </DataTemplate>
                            </views:CopyListBox.ItemTemplate>
                        </views:CopyListBox>
                        <views:CopyListBox ItemsSource="{Binding MergeRegions}" Background="Transparent" IsVisible="{Binding ShowingMerge}">
                            <views:CopyListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:MergeRegionRow">
                                    <StackPanel Margin="8,4,8,8">
                                        <views:CopyableText Classes="diff" CopyKey="context" Text="{Binding Context}" TextWrapping="Wrap" IsVisible="{Binding IsContext}"/>
                                        <Grid ColumnDefinitions="*,8,*,8,*" IsVisible="{Binding IsConflict}">
                                            <StackPanel>
                                                <Button Classes="flat" Content="Take ours" Command="{Binding TakeOursCommand}" HorizontalAlignment="Left" Margin="0,0,0,4"/>
                                                <views:CopyableText Classes="diff" CopyKey="ours" Text="{Binding OursDisplay}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <TextBox Grid.Column="2" Classes="diff" Text="{Binding Result, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap"
                                                     MinHeight="72" MaxHeight="280" VerticalContentAlignment="Top"/>
                                            <StackPanel Grid.Column="4">
                                                <Button Classes="flat" Content="Take theirs" Command="{Binding TakeTheirsCommand}" HorizontalAlignment="Left" Margin="0,0,0,4"/>
                                                <views:CopyableText Classes="diff" CopyKey="theirs" Text="{Binding TheirsDisplay}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel IsVisible="{Binding ShowBaseSection}" Margin="0,6,0,0" Spacing="2">
                                            <TextBlock Text="Base" Opacity="0.65" FontSize="12"/>
                                            <views:CopyableText Classes="diff" CopyKey="base" Text="{Binding BaseDisplay}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </views:CopyListBox.ItemTemplate>
                        </views:CopyListBox>
                    </Grid>
                </DockPanel>
            </Grid>
        </Grid>

        <Border Grid.Row="5" IsVisible="{Binding CommandsOpen}" HorizontalAlignment="Stretch"
                Height="168" Padding="8,4,8,8" Margin="0" ClipToBounds="True"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
            <Grid RowDefinitions="Auto,*">
                <TextBlock Text="Commands" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="CommandLogBox" Grid.Row="1" Classes="diff"
                         IsReadOnly="True" AcceptsReturn="True" IsUndoEnabled="False"
                         TextWrapping="NoWrap" VerticalContentAlignment="Top"
                         HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                         ClearSelectionOnLostFocus="False"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         PlaceholderText="No commands yet.">
                    <TextBox.ContextFlyout>
                        <MenuFlyout Opening="OnCommandLogMenuOpening">
                            <MenuItem Header="Copy" Command="{Binding $parent[TextBox].Copy}" IsEnabled="{Binding $parent[TextBox].CanCopy}" InputGesture="{x:Static TextBox.CopyGesture}"/>
                            <MenuItem x:Name="CommandLogSelectAllItem" Header="Select all" Command="{Binding $parent[TextBox].SelectAll}"/>
                        </MenuFlyout>
                    </TextBox.ContextFlyout>
                </TextBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
